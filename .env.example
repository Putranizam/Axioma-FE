# =============================================================================
# AXIOMA FRONTEND ENVIRONMENT VARIABLES (.env.example)
# Salin berkas ini menjadi `.env.local` (development) atau atur di dashboard
# hosting (Vercel / Railway / Render / Cloudflare) sebelum menjalankan build.
# JANGAN PERNAH menaruh SUPABASE_SERVICE_KEY atau GEMINI_API_KEY di frontend!
# =============================================================================

# URL publik backend Express (tanpa garis miring di akhir)
# Contoh produksi : https://api.axioma.id
# Contoh lokal    : http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# URL publik frontend untuk metadata Open Graph, canonical URL, dan sitemap/robots
# Contoh produksi : https://axioma.id
NEXT_PUBLIC_APP_URL=http://localhost:3000

# (Opsional — untuk Tahap 3: Login Supabase Auth)
# NEXT_PUBLIC_SUPABASE_URL=https://project-id.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# =============================================================================
# INTEGRASI CLOUDFLARE TURNSTILE (PRODUKSI)
# =============================================================================
# Site Key publik Cloudflare Turnstile (mode Invisible/Managed).
# Kosongkan di development agar pengiriman pesan tidak memerlukan token anti-bot.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key-here

# Mode Demo / Staging Indexing:
# Setel ke "true" hanya jika situs siap diindeks mesin pencari di domain produksi.
# Default bernilai "false" (robots.txt melarang seluruh crawler dan halaman memakai meta noindex).
NEXT_PUBLIC_ALLOW_INDEXING=false



